# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API (or "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: the public address of the site, used in email links.
# Leave empty to detect it automatically.
NEXT_PUBLIC_SITE_URL=
